@using System.Security.Claims
@using Microsoft.AspNetCore.Identity

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ThesisWebApp</title>
    <script type="importmap"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ThesisWebApp.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark navbar-site border-bottom box-shadow mb-0 fixed-top">
            <div class="container">
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link text-white-50 nav-link-site" asp-area="" asp-page="/Index">Početna</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white-50 nav-link-site" asp-area="" asp-controller="Data" asp-action="Index">Merenja</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white-50 nav-link-site" asp-area="" asp-controller="Data" asp-action="Analiza">Analiza</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white-50 nav-link-site" asp-area="" asp-controller="Data" asp-action="StrukturnaAnaliza">Strukturna Analiza</a>
                        </li>
                    </ul>
                    <span class="navbar-brand navbar-brand-site text-white mb-0">Monitoring Podataka</span>
                    <div class="d-flex ms-auto">
                        @await Html.PartialAsync("~/Views/Shared/_LoginPartial.cshtml")
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <main role="main" class="container-fluid px-0">
        @RenderBody()
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
