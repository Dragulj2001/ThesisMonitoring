@using System.Security.Claims
@using Microsoft.AspNetCore.Identity

@if (User.Identity?.IsAuthenticated == true)
{
    var email = User.FindFirstValue(ClaimTypes.Email) ?? User.Identity?.Name;
    <div class="d-flex align-items-center gap-2">
        <span class="text-white-50 small mb-0">@email</span>

        <form method="post" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="/Index" class="m-0">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-outline-danger btn-sm">
                Logout
            </button>
        </form>
    </div>
}
else
{
    <div class="d-flex align-items-center gap-2">
        <a class="btn btn-primary btn-sm" asp-area="Identity" asp-page="/Account/Login">Login</a>
        <a class="btn btn-outline-primary btn-sm" asp-area="Identity" asp-page="/Account/Register">Register</a>
    </div>
}

